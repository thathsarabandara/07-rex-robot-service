APP_NAME=rex-robot-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rex_robot
MYSQL_USER=rex_user
MYSQL_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/1

USER_JWT_SECRET_KEY=change-me
USER_JWT_ALGORITHM=HS256
USER_JWT_ISSUER=rex-auth-service
USER_JWT_AUDIENCE=rex-platform

ROBOT_JWT_SECRET_KEY=change-me
ROBOT_JWT_ALGORITHM=HS256
ROBOT_ACCESS_TOKEN_EXPIRE_HOURS=12
ROBOT_REFRESH_TOKEN_EXPIRE_DAYS=30

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=rex_robot_service
MQTT_PASSWORD=change-me
MQTT_TLS_ENABLED=false
MQTT_KEEPALIVE_SECONDS=30
MQTT_COMMAND_QOS=1

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=rex-robot-service

AUTH_SERVICE_URL=http://rex-auth-service:9001

CONTROL_LEASE_EXPIRE_SECONDS=10
JOYSTICK_COMMAND_TIMEOUT_MS=500
MAX_WEBSOCKET_MESSAGES_PER_SECOND=30

DEFAULT_HEARTBEAT_INTERVAL_SECONDS=5
DEFAULT_HEARTBEAT_TIMEOUT_SECONDS=20

GHCR_IMAGE=ghcr.io/OWNER/07-rex-robot-service
